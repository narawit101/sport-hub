# App
NODE_ENV=<development or production>
PORT=5000

# Database (Supabase PostgreSQL)
DATABASE_URL=<your_supabase_postgresql_url>
# Optional override if your provider gives a separate IPv4/pooler host
# PGHOST=<your_ipv4_or_pooler_hostname>

# Authentication
JWT_SECRET=<your_jwt_secret_key>

# Redis (Upstash)
REDIS_URL=<your_upstash_redis_url>

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Email (Gmail SMTP via Nodemailer)
SMTP_USER=<your_gmail_address>
SMTP_PASS=<your_gmail_app_password>
SENDER_EMAIL=<from_address_shown_in_emails>

# Frontend URL (for email links)
FONT_END_URL=<your_frontend_url>

# Cloudinary (Image/File Storage)
CLOUND_NAME=<your_cloudinary_name>
CLOUND_API_KEY=<your_cloudinary_api_key>
CLOUND_API_SECRET=<your_cloudinary_api_secret>
